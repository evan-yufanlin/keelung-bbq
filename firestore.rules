rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /headcounts/{doc} {
      allow read: if true;
      allow create, update: if request.auth != null
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 40
                    && request.resource.data.adults is int
                    && request.resource.data.kids is int
                    && request.resource.data.adults >= 0
                    && request.resource.data.kids >= 0;
      allow delete: if request.auth != null;
    }

    match /claims/{doc} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 40
                    && request.resource.data.itemKey is string
                    && request.resource.data.itemKey.size() < 80;
      allow delete: if request.auth != null;
      allow update: if false;
    }

    match /customItems/{doc} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 40
                    && request.resource.data.category is string;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
